# Lightweight Dockerfile for building u-boot for Tachyon
# This is much faster than the full tools/docker/Dockerfile

FROM ubuntu:jammy-20240911.1

ENV DEBIAN_FRONTEND=noninteractive

# Install only what we need for tachyon u-boot build
RUN apt-get update && apt-get install -y \
    gcc \
    gcc-aarch64-linux-gnu \
    make \
    bc \
    bison \
    flex \
    libssl-dev \
    libgnutls28-dev \
    device-tree-compiler \
    python3 \
    python3-dev \
    python3-setuptools \
    python3-pyelftools \
    git \
    xxd \
    && rm -rf /var/lib/apt/lists/*

# Create working directory
WORKDIR /project

# Default command
CMD ["/bin/bash"]
